{
 "title": "identity-risk-graph",
 "uid": "irg-overview",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "tags": [
  "identity",
  "security",
  "ai-agents"
 ],
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "refresh": "30s",
 "templating": {
  "list": [
   {
    "name": "datasource",
    "type": "datasource",
    "query": "prometheus",
    "current": {}
   },
   {
    "name": "tenant",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "query": "label_values(irg_open_findings, tenant)",
    "includeAll": true,
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "allValue": ".*"
   }
  ]
 },
 "panels": [
  {
   "type": "row",
   "title": "Identity risk",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "id": 1,
   "panels": []
  },
  {
   "type": "stat",
   "title": "Critical risks open",
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 0,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(irg_open_findings{severity=\"critical\", tenant=~\"$tenant\"})"
    }
   ]
  },
  {
   "type": "stat",
   "title": "High risks open",
   "id": 3,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 6,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(irg_open_findings{severity=\"high\", tenant=~\"$tenant\"})"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Agent actions denied (1h)",
   "id": 4,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 12,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(irg_agent_decisions_total{decision=\"deny\"}[1h]))"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Agent actions sent for approval (1h)",
   "id": 5,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 18,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(irg_agent_decisions_total{decision=\"require_approval\"}[1h]))"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Open findings by severity",
   "description": "",
   "id": 6,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 24,
    "x": 0,
    "y": 5
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (severity) (irg_open_findings{tenant=~\"$tenant\"})",
     "legendFormat": "{{severity}}"
    }
   ]
  },
  {
   "type": "row",
   "title": "AI-agent decisions",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 13
   },
   "id": 7,
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Decisions per second",
   "description": "",
   "id": 8,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 14
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (decision) (rate(irg_agent_decisions_total[$__rate_interval]))",
     "legendFormat": "{{decision}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Decision time in the engine",
   "description": "Alert IrgAgentDecisionSlow fires above 1 ms p99 for 10 minutes",
   "id": 9,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 14
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(irg_agent_decision_seconds_bucket[$__rate_interval])))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.99, sum by (le) (rate(irg_agent_decision_seconds_bucket[$__rate_interval])))",
     "legendFormat": "p99"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Decisions answered but not logged",
   "description": "",
   "id": 10,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 22
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(irg_decision_log_dropped_total[$__rate_interval]))",
     "legendFormat": "dropped"
    }
   ]
  },
  {
   "type": "row",
   "title": "API",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 30
   },
   "id": 11,
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Requests by route and status",
   "description": "",
   "id": 12,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 31
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (route, code) (rate(irg_http_requests_total[$__rate_interval]))",
     "legendFormat": "{{route}} {{code}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "p99 latency by route",
   "description": "",
   "id": 13,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 31
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.99, sum by (le, route) (rate(irg_http_request_seconds_bucket[$__rate_interval])))",
     "legendFormat": "{{route}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "5xx ratio (5m / 1h) against the 99.9% budget",
   "description": "",
   "id": 14,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 39
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "irg:http_errors:ratio_rate5m",
     "legendFormat": "5m"
    },
    {
     "refId": "B",
     "expr": "irg:http_errors:ratio_rate1h",
     "legendFormat": "1h"
    },
    {
     "refId": "C",
     "expr": "vector(14.4 * 0.001)",
     "legendFormat": "page threshold"
    }
   ]
  },
  {
   "type": "row",
   "title": "Pipeline",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 47
   },
   "id": 15,
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Jobs by outcome",
   "description": "",
   "id": 16,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 48
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (kind, outcome) (increase(irg_jobs_total[$__rate_interval]))",
     "legendFormat": "{{kind}} {{outcome}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Job duration p95",
   "description": "",
   "id": 17,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 48
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, kind) (rate(irg_job_seconds_bucket[$__rate_interval])))",
     "legendFormat": "{{kind}}"
    }
   ]
  },
  {
   "type": "row",
   "title": "SIEM export and tracing",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 56
   },
   "id": 18,
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "SIEM events by outcome",
   "description": "",
   "id": 19,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 57
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (sink, outcome) (rate(irg_siem_events_total[$__rate_interval]))",
     "legendFormat": "{{sink}} {{outcome}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "SIEM delivery lag",
   "description": "",
   "id": 20,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 57
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (sink, stream) (irg_siem_delivery_lag_seconds)",
     "legendFormat": "{{sink}} {{stream}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Spans exported, dropped, failed",
   "description": "",
   "id": 21,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 65
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (outcome) (rate(irg_trace_spans_total[$__rate_interval]))",
     "legendFormat": "{{outcome}}"
    }
   ]
  }
 ]
}
